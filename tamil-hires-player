        });

        // Shuffle & Repeat toggles
        shuffleBtn.addEventListener('click', () => {
            isShuffle = !isShuffle;
            shuffleBtn.classList.toggle('text-brand-400', isShuffle);
        });

        repeatBtn.addEventListener('click', () => {
            isRepeat = !isRepeat;
            repeatBtn.classList.toggle('text-brand-400', isRepeat);
        });

        // --- Transport Buttons ---
        playBtn.addEventListener('click', togglePlay);
        nextBtn.addEventListener('click', nextTrack);
        prevBtn.addEventListener('click', prevTrack);

        // --- Modals Toggle Listeners ---
        btnOpenEQ.addEventListener('click', () => eqModal.classList.remove('hidden'));
        btnCloseEQ.addEventListener('click', () => eqModal.classList.add('hidden'));

        btnOpenSetup.addEventListener('click', () => setupModal.classList.remove('hidden'));
        btnCloseSetup.addEventListener('click', () => setupModal.classList.add('hidden'));

        // Close modal on outer click
        window.addEventListener('click', (e) => {
            if (e.target === eqModal) eqModal.classList.add('hidden');
            if (e.target === setupModal) setupModal.classList.add('hidden');
        });

        // --- Init App on Page Load ---
        window.onload = () => {
            renderPlaylist();
            loadTrack(0);
        };
    </script>
