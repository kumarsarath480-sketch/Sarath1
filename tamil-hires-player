        // --- Audio Element Event Listeners ---
        audioElement.addEventListener('timeupdate', () => {
            if (audioElement.duration) {
                const progress = (audioElement.currentTime / audioElement.duration) * 100;
                seekBar.value = progress;

                // Format Time
                const curMins = Math.floor(audioElement.currentTime / 60);
                const curSecs = Math.floor(audioElement.currentTime % 60);
                const durMins = Math.floor(audioElement.duration / 60);
                const durSecs = Math.floor(audioElement.duration % 60);

                currentTimeEl.innerText = `${curMins < 10 ? '0' : ''}${curMins}:${curSecs < 10 ? '0' : ''}${curSecs}`;
                durationTimeEl.innerText = `${durMins < 10 ? '0' : ''}${durMins}:${durSecs < 10 ? '0' : ''}${durSecs}`;
            }
        });

        audioElement.addEventListener('ended', () => {
            if (isRepeat) {
                audioElement.currentTime = 0;
                audioElement.play();
            } else {
                nextTrack();
            }
        });

        // Seek Bar interaction
        seekBar.addEventListener('input', () => {
            if (audioElement.duration) {
                audioElement.currentTime = (seekBar.value / 100) * audioElement.duration;
            }
        });

