        ];

        // --- Application State ---
        let currentPlaylist = [...MASTER_PLAYLIST];
        let currentTrackIndex = 0;
        let isPlaying = false;
        let isMuted = false;
        let isShuffle = false;
        let isRepeat = false;

        // --- Web Audio API Nodes ---
        let audioCtx = null;
        let audioSource = null;
        let analyser = null;
        let eqFilters = [];
        let isAudioEngineInit = false;

        // --- DOM Elements ---
        const audioElement = document.getElementById('audioElement');
        const playBtn = document.getElementById('btnPlay');
        const playIcon = document.getElementById('playIcon');
        const prevBtn = document.getElementById('btnPrev');
        const nextBtn = document.getElementById('btnNext');
        const seekBar = document.getElementById('seekBar');
        const volumeBar = document.getElementById('volumeBar');
        const muteBtn = document.getElementById('btnMute');
        const volumeIcon = document.getElementById('volumeIcon');
        const shuffleBtn = document.getElementById('btnShuffle');
        const repeatBtn = document.getElementById('btnRepeat');

        const trackTitle = document.getElementById('trackTitle');
        const trackArtist = document.getElementById('trackArtist');
        const trackAlbum = document.getElementById('trackAlbum');
        const trackCover = document.getElementById('trackCover');
        const badgeFormat = document.getElementById('badgeFormat');
        const vinylDisk = document.getElementById('vinylDisk');
        const currentTimeEl = document.getElementById('currentTime');
        const durationTimeEl = document.getElementById('durationTime');

        const playlistContainer = document.getElementById('playlistContainer');
        const searchInput = document.getElementById('searchInput');
        const localFileInput = document.getElementById('localFileInput');
        const visualizerCanvas = document.getElementById('visualizerCanvas');
        const canvasCtx = visualizerCanvas.getContext('2d');

        // Modals DOM
        const eqModal = document.getElementById('eqModal');
        const btnOpenEQ = document.getElementById('btnOpenEQ');
        const btnCloseEQ = document.getElementById('btnCloseEQ');
        
        const setupModal = document.getElementById('setupModal');
        const btnOpenSetup = document.getElementById('btnOpenSetup');
        const btnCloseSetup = document.getElementById('btnCloseSetup');

        // Initialize Lucide Icons
        lucide.createIcons();

        // --- Web Audio API Initialization ---
        function initWebAudioEngine() {
            if (isAudioEngineInit) return;

            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContext();

                // Create Source Node from HTML5 Audio Element
                audioSource = audioCtx.createMediaElementSource(audioElement);

                // Create 5-Band Biquad Filter Equalizer
                const frequencies = [60, 250, 1000, 4000, 12000];
                eqFilters = frequencies.map((freq, index) => {
                    const filter = audioCtx.createBiquadFilter();
                    if (index === 0) {
                        filter.type = 'lowshelf';
                    } else if (index === frequencies.length - 1) {
                        filter.type = 'highshelf';
                    } else {
                        filter.type = 'peaking';
                        filter.Q.value = 1.0;
                    }
                    filter.frequency.value = freq;
                    filter.gain.value = 0;
                    return filter;
                });

                // Create Analyser Node for Visualizer
                analyser = audioCtx.createAnalyser();
                analyser.fftSize = 256;

                // Connect Signal Chain: Source -> EQ Filters -> Analyser -> Destination
                audioSource.connect(eqFilters[0]);
                for (let i = 0; i < eqFilters.length - 1; i++) {
                    eqFilters[i].connect(eqFilters[i + 1]);
                }
                eqFilters[eqFilters.length - 1].connect(analyser);
                analyser.connect(audioCtx.destination);

                isAudioEngineInit = true;
                document.getElementById('audioEngineStatus').innerText = "DSP 24-BIT ACTIVE";
                document.getElementById('sampleRateDisplay').innerText = `${audioCtx.sampleRate} Hz / Bit-Exact`;

                // Start Visualizer Loop
                drawSpectrumVisualizer();
            } catch (e) {
                console.warn("Web Audio API could not be initialized directly:", e);
            }
        }

        // --- Real-Time Audio Spectrum Visualizer ---
        function drawSpectrumVisualizer() {
            requestAnimationFrame(drawSpectrumVisualizer);

            const width = visualizerCanvas.width = visualizerCanvas.clientWidth;
            const height = visualizerCanvas.height = visualizerCanvas.clientHeight;

            canvasCtx.clearRect(0, 0, width, height);

            if (!analyser || !isPlaying) {
                // Idle Spectrum Graphic when paused
                canvasCtx.fillStyle = 'rgba(56, 189, 248, 0.15)';
                canvasCtx.fillRect(0, height - 2, width, 2);
                return;
            }

            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);
            analyser.getByteFrequencyData(dataArray);

            const barWidth = (width / bufferLength) * 2.2;
            let barHeight;
            let x = 0;

            for (let i = 0; i < bufferLength; i++) {
                barHeight = (dataArray[i] / 255) * height;

                // Dynamic Audio Gradient (Cyan to Rose Glow)
                const gradient = canvasCtx.createLinearGradient(0, height, 0, 0);
                gradient.addColorStop(0, '#0284c7');
                gradient.addColorStop(0.6, '#38bdf8');
                gradient.addColorStop(1, '#f43f5e');

                canvasCtx.fillStyle = gradient;
                canvasCtx.fillRect(x, height - barHeight, barWidth - 1, barHeight);

                x += barWidth;
            }
        }

        // --- Track Loading & Playback Functions ---
        function loadTrack(index) {
            if (currentPlaylist.length === 0) return;

            currentTrackIndex = index;
            const track = currentPlaylist[currentTrackIndex];

            audioElement.src = track.url;
            trackTitle.innerText = track.title;
            trackArtist.innerText = track.artist;
            trackAlbum.innerText = track.album || "Hi-Res Tamil Master";
            trackCover.src = track.cover;
            badgeFormat.innerText = track.format;

            // Reset Seekbar
            seekBar.value = 0;
            currentTimeEl.innerText = "00:00";
            durationTimeEl.innerText = "00:00";

            renderPlaylist();

            if (isPlaying) {
                audioElement.play().catch(e => console.log("User interaction required:", e));
            }
        }

        function togglePlay() {
            // Resume AudioContext if suspended by browser autoplay policy
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            } else if (!isAudioEngineInit) {
                initWebAudioEngine();
            }

            if (isPlaying) {
                audioElement.pause();
                isPlaying = false;
                playIcon.setAttribute('data-lucide', 'play');
                vinylDisk.classList.add('paused');
            } else {
                audioElement.play().then(() => {
                    isPlaying = true;
                    playIcon.setAttribute('data-lucide', 'pause');
                    vinylDisk.classList.remove('paused');
                }).catch(err => {
                    console.error("Playback error:", err);
                });
            }
            lucide.createIcons();
        }

        function nextTrack() {
            if (isShuffle) {
                currentTrackIndex = Math.floor(Math.random() * currentPlaylist.length);
            } else {
                currentTrackIndex = (currentTrackIndex + 1) % currentPlaylist.length;
            }
            loadTrack(currentTrackIndex);
            if (!isPlaying) togglePlay();
        }

        function prevTrack() {
            currentTrackIndex = (currentTrackIndex - 1 + currentPlaylist.length) % currentPlaylist.length;
            loadTrack(currentTrackIndex);
            if (!isPlaying) togglePlay();
        }

        // --- Playlist UI Renderer ---
        function renderPlaylist() {
            playlistContainer.innerHTML = '';
            document.getElementById('trackCountBadge').innerText = `${currentPlaylist.length} tracks`;

            if (currentPlaylist.length === 0) {
                playlistContainer.innerHTML = `
                    <div class="text-center py-8 text-slate-500 text-xs">
                        No songs found matching filter.
                    </div>
                `;
                return;
            }

            currentPlaylist.forEach((track, idx) => {
                const isActive = idx === currentTrackIndex;
                const item = document.createElement('div');
                item.className = `p-2.5 rounded-xl flex items-center justify-between cursor-pointer transition-all border ${
                    isActive 
                    ? 'bg-brand-500/15 border-brand-400/40 text-white shadow-md' 
                    : 'bg-slate-900/40 border-white/5 text-slate-300 hover:bg-slate-800/60 hover:border-white/10'
                }`;

                item.innerHTML = `
                    <div class="flex items-center space-x-3 truncate">
                        <img src="${track.cover}" class="w-10 h-10 rounded-lg object-cover flex-shrink-0" alt="art">
                        <div class="truncate">
                            <h4 class="font-semibold text-xs truncate ${isActive ? 'text-brand-400' : 'text-slate-200'}">${track.title}</h4>
                            <p class="text-[11px] text-slate-400 truncate">${track.artist}</p>
