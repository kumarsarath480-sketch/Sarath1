                        <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-white/5 font-mono block">${track.format.split(' ')[0]}</span>
                    </div>
                `;

                item.onclick = () => {
                    currentTrackIndex = idx;
                    loadTrack(currentTrackIndex);
                    if (!isPlaying) togglePlay();
                };

                playlistContainer.appendChild(item);
            });
        }

        // --- EQ Bands & Presets Logic ---
        const EQ_PRESETS = {
            flat: [0, 0, 0, 0, 0],
            bass: [8, 5, 0, -1, -2],
            clarity: [-2, 1, 4, 6, 4],
            acoustic: [4, 2, 1, 3, 5],
            treble: [-3, -1, 2, 6, 9]
        };

        function setEqGain(bandIndex, gainValue) {
            if (eqFilters[bandIndex]) {
                eqFilters[bandIndex].gain.value = gainValue;
            }
        }

        document.querySelectorAll('.eq-band').forEach(slider => {
            slider.addEventListener('input', (e) => {
                const bandIndex = parseInt(e.target.getAttribute('data-band'));
                const val = parseFloat(e.target.value);
                setEqGain(bandIndex, val);
            });
        });

        document.querySelectorAll('.eq-preset-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
